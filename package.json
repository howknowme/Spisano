{
  "name": "subly",
  "version": "1.1.0",
  "private": true,
  "description": "Трекер подписок и регулярных платежей без регистрации. Офлайн PWA, данные только на устройстве.",
  "type": "module",
  "scripts": {
    "start": "python3 -m http.server 8080",
    "test": "node --test tests/core.test.mjs tests/native.test.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "build:artifact": "node scripts/build-artifact.mjs",
    "build": "node scripts/build-www.mjs",
    "fonts": "node scripts/vendor-fonts.mjs",
    "android:sync": "npm run build && npx cap sync android"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/howknowme/subly"
  },
  "homepage": "https://howknowme.github.io/subly/",
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/share": "8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@fontsource/manrope": "5.3.0",
    "@fontsource/unbounded": "5.3.0"
  }
}
