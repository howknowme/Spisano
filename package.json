{
  "name": "catedra",
  "productName": "Catedra",
  "version": "1.0.0",
  "description": "Catedra – asistentul digital al profesorului (catalog, medii, absențe, orar, planificare, proiecte de lecție, teste).",
  "main": "main.js",
  "author": {
    "name": "Catedra",
    "email": "noreply@catedra.local"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win dir --x64 && makensis build/installer.nsi",
    "dist:linux": "electron-builder --linux deb --x64",
    "build:html": "node scripts/build-single.js",
    "dist:android": "node scripts/build-single.js www/index.html && npx cap sync android && cd android && ./gradlew assembleRelease"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.11",
    "@capacitor/app": "^7.1.2",
    "@capacitor/cli": "^7.6.11",
    "@capacitor/core": "^7.6.11",
    "@capacitor/filesystem": "^7.1.9",
    "@capacitor/share": "^7.0.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ro.catedra.app",
    "productName": "Catedra",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "build/icon.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Catedra",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "Catedra-Setup-${version}.exe",
      "language": "1048"
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Education",
      "maintainer": "Catedra <noreply@catedra.local>",
      "synopsis": "Asistentul profesorului",
      "artifactName": "catedra_${version}_amd64.deb"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.education"
    },
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ]
    }
  },
  "homepage": "https://github.com/howknowme/youtube-"
}
